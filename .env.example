# Beyond Financials - Environment Configuration Reference
# IMPORTANT: Never store sensitive secrets or credentials in client-side code.

# Server & Runtime Configuration
PORT=3000
NODE_ENV="development"
APP_URL="https://beyondfinancials.ng"

# Gemini API Key (Server-Side Only - Injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Pre-Launch Admin Access Key (For /admin/leads API verification)
# Required. The server denies every admin request when this is empty. There is no built-in key.
ADMIN_API_KEY=""

# External Provider Configuration (Future Integrations - Currently Mocked)
# BANKING_PROVIDER_API_KEY=""
# KYC_PROVIDER_SECRET=""
# PAYMENT_GATEWAY_KEY=""
# BILLS_PROVIDER_TOKEN=""
# NOTIFICATION_SERVICE_KEY=""

# Transactional email (Resend). Server-side only. Never prefix these with VITE_.
# Leave RESEND_API_KEY empty until a verified sending domain exists.
# EMAIL_DELIVERY_MODE=live is required outside production. Production sends when the key and EMAIL_FROM are set.
# EMAIL_DELIVERY_MODE=log disables live sending even in production.
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""
EMAIL_LOGO_URL=""
APP_BASE_URL=""
EMAIL_CONTACT_INBOX=""
EMAIL_LEADS_INBOX=""
EMAIL_DELIVERY_MODE=""

